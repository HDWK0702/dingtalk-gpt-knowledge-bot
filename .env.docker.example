# Copy this file to .env before using Docker Compose.
# Never put real API keys, DingTalk secrets, or private knowledge files in Git.

# The folder on your computer containing Markdown knowledge files.
# Windows example: KNOWLEDGE_PATH=E:/company-knowledge
# The default uses this repository's non-sensitive demo notes.
KNOWLEDGE_PATH=./demo/knowledge

# Expose the health API only on this computer by default.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# DingTalk Stream application credentials from DingTalk Open Platform.
DINGTALK_CLIENT_ID=replace_with_your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=replace_with_your_dingtalk_client_secret

# Chat model. Set OPENAI_BASE_URL only for an OpenAI-compatible provider.
OPENAI_API_KEY=replace_with_your_llm_api_key
OPENAI_BASE_URL=
OPENAI_MODEL=replace_with_your_chat_model

# Embedding model. It may use a different provider from the chat model.
EMBEDDING_API_KEY=replace_with_your_embedding_api_key
EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=replace_with_your_embedding_model
RAG_RETRIEVAL_MODE=embedding
RAG_MIN_SIMILARITY=0.25
RAG_RELATED_PREVIEW_CHARS=360
# Optional reranker. RERANK_URL must be the complete POST endpoint, such as https://api.example.com/v1/rerank.
RERANK_ENABLED=false
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CANDIDATE_LIMIT=12
RERANK_TIMEOUT_SECONDS=15

# The files inside KNOWLEDGE_PATH are scanned recursively. Leave blank to use it all.
OBSIDIAN_KNOWLEDGE_SUBDIR=
CHUNK_MODE=structure
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_RATIO=0.15
MAX_QUESTION_LENGTH=2000
LLM_TIMEOUT_SECONDS=45
# Split normal requests between both configured chat-model routes. The other route remains the failover.
LLM_LOAD_BALANCE_ENABLED=true
PRIMARY_LLM_WEIGHT=50
FALLBACK_LLM_WEIGHT=50
INTERNAL_API_TOKEN=
REDIS_URL=redis://redis:6379/0
RAG_STORAGE=postgres

# PostgreSQL + pgvector. Change the password before shared or production use.
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me_before_deploy
DATABASE_URL=postgresql://knowledge:change_me_before_deploy@postgres:5432/knowledge
PGVECTOR_DIMENSIONS=1024

# Logs are written to the Docker app_data volume and can be read with docker compose logs/exec.
QA_LOG_PATH=/app/data/logs/qa_logs.jsonl
RETRIEVAL_LOG_PATH=/app/data/logs/retrieval_logs.jsonl
RETRIEVAL_LOG_MD_PATH=/app/data/logs/retrieval_logs.md

# PostgreSQL + pgvector. The database is private to the Docker network.
# Change POSTGRES_PASSWORD before any shared or production deployment.
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=change_me_before_deploy
DATABASE_URL=postgresql://knowledge:change_me_before_deploy@postgres:5432/knowledge
