# DingTalk application credentials from the Open Platform. Never commit the real values.
DINGTALK_CLIENT_ID=your_dingtalk_client_id
DINGTALK_CLIENT_SECRET=your_dingtalk_client_secret

# OpenAI API credentials. This is separate from a ChatGPT subscription.
OPENAI_API_KEY=your_llm_api_key
OPENAI_BASE_URL=
OPENAI_MODEL=your_chat_model

# Dedicated Embedding API configuration. Keep it separate from the chat model.
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=your_embedding_model
RAG_RETRIEVAL_MODE=embedding
RAG_INDEX_PATH=rag_index.json
RAG_MIN_SIMILARITY=0.25
RAG_RELATED_PREVIEW_CHARS=360
# Chunk length includes document/section titles; measured in characters, not tokens.
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=120

# Absolute path to the Obsidian vault and the folder used as the knowledge source.
OBSIDIAN_VAULT_PATH=./demo
OBSIDIAN_KNOWLEDGE_SUBDIR=knowledge
MAX_QUESTION_LENGTH=2000
LLM_TIMEOUT_SECONDS=45
INTERNAL_API_TOKEN=
REDIS_URL=redis://redis:6379/0
# Append-only local Q&A and feedback log. Relative paths are from the project directory.
QA_LOG_PATH=data/qa_logs.jsonl
# Optional RAG optimization orchestrator (GPT-6 plans/reviews; five Luna workers execute)
ORCHESTRATOR_MODEL=gpt-6-astra
WORKER_MODEL=gpt-5.6-luna
# Leave blank to reuse OPENAI_BASE_URL / OPENAI_API_KEY.
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_API_KEY=
WORKER_BASE_URL=
WORKER_API_KEY=
ORCHESTRATOR_TIMEOUT_SECONDS=90
